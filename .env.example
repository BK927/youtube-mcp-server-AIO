# ---------------------------
# YouTube providers
# ---------------------------

# Enables official public-data tools such as search, comments, playlists, and trending.
YOUTUBE_API_KEY=

# hybrid | official | unofficial
YOUTUBE_PROVIDER_MODE=hybrid

# Comma-separated transcript fallback order.
YOUTUBE_TRANSCRIPT_PROVIDERS=yt-dlp,youtubejs
YT_DLP_PATH=yt-dlp

YOUTUBE_DEFAULT_REGION=KR
YOUTUBE_DEFAULT_LANGUAGE=ko
YOUTUBE_REQUEST_TIMEOUT_MS=15000
YOUTUBE_CACHE_TTL_SECONDS=900

# Conservative local guards. They estimate only calls made by this process.
YOUTUBE_API_DAILY_BUDGET=9000
YOUTUBE_SEARCH_DAILY_BUDGET=90

# Account-scoped write tools are not implemented yet.
YOUTUBE_ENABLE_WRITE_TOOLS=false

# ---------------------------
# MCP transport / Cloud Run
# ---------------------------

# stdio for local subprocess clients; http for Cloud Run / remote MCP.
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
HEALTH_PATH=/healthz
HTTP_MAX_BODY_BYTES=2097152
HTTP_REQUEST_TIMEOUT_MS=300000

# Required in HTTP mode unless MCP_ALLOW_UNAUTHENTICATED=true.
# Generate at least 32 random characters and send it as Authorization: Bearer <token>.
MCP_ACCESS_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false

# Set after the first Cloud Run deployment, for example:
# https://youtube-mcp-aio-123456789012.asia-northeast1.run.app
PUBLIC_BASE_URL=

# Optional exact allowlists. PUBLIC_BASE_URL is automatically added.
# Browser-origin requests are rejected unless their exact origin is listed.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=

# ---------------------------
# Optional Google OAuth for YouTube user data
# ---------------------------

# This authorizes the server to access an owned YouTube account later.
# It does NOT authenticate MCP clients calling /mcp.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Two different 32+ character random secrets.
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_SETUP_TOKEN=

# Returned by the one-time setup page and then stored in Secret Manager.
GOOGLE_OAUTH_REFRESH_TOKEN=

GOOGLE_OAUTH_REDIRECT_PATH=/oauth/google/callback
GOOGLE_OAUTH_SETUP_PATH=/oauth/google/setup
GOOGLE_OAUTH_START_PATH=/oauth/google/start
GOOGLE_OAUTH_STATUS_PATH=/oauth/google/status
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Space- or comma-separated. Keep scopes minimal until a feature needs more.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly
