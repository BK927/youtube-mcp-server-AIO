# ---------------------------
# YouTube providers
# ---------------------------

# Enables official public-data tools such as search, comments, playlists, and trending.
YOUTUBE_API_KEY=

# hybrid | official | unofficial
YOUTUBE_PROVIDER_MODE=hybrid

# Comma-separated transcript fallback order.
YOUTUBE_TRANSCRIPT_PROVIDERS=yt-dlp,youtubejs
YT_DLP_PATH=yt-dlp
# Enable only when a compatible local PO-token provider is listening on 127.0.0.1:4416.
YT_DLP_POT_PROVIDER_ENABLED=false

YOUTUBE_DEFAULT_REGION=KR
YOUTUBE_DEFAULT_LANGUAGE=ko
YOUTUBE_REQUEST_TIMEOUT_MS=15000
YOUTUBE_CACHE_TTL_SECONDS=900
YOUTUBE_QUOTA_STORE=memory
GOOGLE_CLOUD_PROJECT=
YOUTUBE_CURSOR_SECRET=
YOUTUBE_CURSOR_TTL_SECONDS=86400
YOUTUBE_MAX_RESULT_BYTES=12288

# Conservative local guards. They estimate only calls made by this process.
YOUTUBE_API_DAILY_BUDGET=9000
YOUTUBE_SEARCH_DAILY_BUDGET=90

# ---------------------------
# MCP transport / Cloud Run
# ---------------------------

# stdio for local subprocess clients; http for Cloud Run / remote MCP.
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8080
MCP_PATH=/mcp
HEALTH_PATH=/healthz
HTTP_MAX_BODY_BYTES=2097152
HTTP_REQUEST_TIMEOUT_MS=300000

# Required in HTTP mode unless MCP_ALLOW_UNAUTHENTICATED=true.
# Generate at least 32 random characters and send it as Authorization: Bearer <token>.
MCP_ACCESS_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false

# Set after the first Cloud Run deployment, for example:
# https://youtube-mcp-aio-123456789012.asia-northeast1.run.app
PUBLIC_BASE_URL=

# Optional exact allowlists. PUBLIC_BASE_URL is automatically added.
# Browser-origin requests are rejected unless their exact origin is listed.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=

# Optional personal ChatGPT OAuth. Cloud Run enables this with Secret Manager.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_SCOPE=youtube.read
MCP_OAUTH_LOGIN_SECRET=
MCP_OAUTH_SIGNING_SECRET=
MCP_OAUTH_STORE=memory
MCP_OAUTH_CODE_COLLECTION=youtube_oauth_codes
