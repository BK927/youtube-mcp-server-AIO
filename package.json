{
  "name": "youtube-mcp-server-aio",
  "version": "1.1.1",
  "description": "Read-only YouTube research MCP server for transcripts, video metadata, comments, search, channels, playlists, and trending",
  "author": "BK927",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BK927/youtube-research-mcp.git"
  },
  "homepage": "https://github.com/BK927/youtube-research-mcp#readme",
  "bugs": {
    "url": "https://github.com/BK927/youtube-research-mcp/issues"
  },
  "type": "module",
  "bin": {
    "youtube-mcp-aio": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:firestore-emulator": "vitest run tests/firestore-emulator.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "youtube",
    "youtube-api",
    "youtube-transcript",
    "transcript",
    "model-context-protocol",
    "ai-agents",
    "video-research",
    "yt-dlp",
    "cloud-run"
  ],
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "7.11.6",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "youtubei.js": "18.0.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
